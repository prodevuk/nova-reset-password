{
    "name": "prodeveluk/nova-reset-password",
    "description": "Reset your user password in Laravel Nova. Supports Nova v4",
    "type": "package",
    "autoload": {
        "psr-4": {
            "Prodevel\\NovaResetPassword\\": "src/"
        }
    },

    "authors": [
        {
            "name": "Promise",
            "email": "promise@prodevel.co.uk"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/nova": "^4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prodevel\\NovaPasswordReset\\PasswordResetServiceProvider"
            ]
        }   
    }
}
